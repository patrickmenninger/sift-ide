{
  "name": "sift",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "eval/harness"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w sift-vscode",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p packages/vscode/src/webview",
    "test": "vitest run",
    "verify": "npm run build && npm run typecheck && npm test",
    "test:watch": "vitest",
    "sift": "node packages/cli/dist/main.js",
    "test:vscode": "npm run test:integration -w sift-vscode",
    "package:vscode": "npm run package -w sift-vscode"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
