{
  "name": "@sift/server",
  "version": "0.2.0",
  "private": true,
  "description": "Sift's engine over JSON-RPC (sift serve), for editors such as the VS Code extension.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@sift/core": "0.2.0",
    "vscode-jsonrpc": "9.0.3"
  }
}
